# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A native libp2p node in OCaml"
description:
  "starling is a from-scratch libp2p implementation in OCaml: TCP, multistream-select, Noise XX, Yamux, Identify and ping. A murmuration of peers, no leader."
maintainer: ["Pete <petkopavlovski@gmail.com>"]
authors: ["Pete <petkopavlovski@gmail.com>"]
license: "MIT"
homepage: "https://github.com/cargopete/starling"
bug-reports: "https://github.com/cargopete/starling/issues"
depends: [
  "ocaml"
  "dune" {>= "3.0"}
  "eio"
  "eio_main"
  "mirage-crypto"
  "mirage-crypto-ec"
  "mirage-crypto-rng"
  "mirage-crypto-rng-eio"
  "digestif"
  "ocaml-protoc-plugin"
  "base58"
  "hex"
  "ipaddr"
  "domain-name"
  "cstruct"
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/cargopete/starling.git"
